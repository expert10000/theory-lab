{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atlas to existing Theory Lab reconciliation metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "policy", "existingFormats", "protectedSchemas", "catalogSha256", "reviewSha256", "sceneReviewIds", "gapGroupIds", "entries"],
  "properties": {
    "schema": {"const": "atlas-lab-reconciliation/v1"},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["repository", "revision"],
      "properties": {"repository": {"const": "https://github.com/expert10000/theory"}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["extension", "executionAuthority", "sourceExamplesAuthorizeExecution", "sceneFlow", "math3dConnected"],
      "properties": {
        "extension": {"const": "additive-reviewed"},
        "executionAuthority": {"const": "existing-tested-atlasBinding"},
        "sourceExamplesAuthorizeExecution": {"const": false},
        "sceneFlow": {"const": "QuantumResult -> QuantumScene -> independent consumers"},
        "math3dConnected": {"const": false}
      }
    },
    "existingFormats": {"type": "array", "minItems": 8, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/definitions/text"}},
    "protectedSchemas": {
      "type": "array", "minItems": 5, "maxItems": 32,
      "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {"path": {"type": "string", "pattern": "^packages/(contracts/schemas|quantum-scene)/[a-z-]+\\.v[0-9]+\\.json$"}, "sha256": {"$ref": "#/definitions/hash"}}}
    },
    "reviewSha256": {"$ref": "#/definitions/hash"},
    "catalogSha256": {"$ref": "#/definitions/hash"},
    "sceneReviewIds": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["C2", "C3", "C4", "C5", "C6", "C7", "C8"]}},
    "gapGroupIds": {"type": "array", "minItems": 12, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/definitions/groupId"}},
    "entries": {"type": "array", "minItems": 68, "maxItems": 512, "items": {"$ref": "#/definitions/entry"}}
  },
  "definitions": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,99}$"},
    "groupId": {"type": "string", "pattern": "^G[0-9]{2}$"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "operation": {"enum": ["diagonalize", "evolve", "cavity", "lindblad", "sweep", "orbital", "circuit", "many_body", "topology", "oscillator", "oscillator_drive"]},
    "sourcePath": {"type": "string", "pattern": "^examples/python/qutip/[A-Za-z0-9_/-]+\\.py$"},
    "sourceExample": {
      "type": "object", "additionalProperties": false, "required": ["kind", "adapter", "example", "notes"],
      "properties": {"kind": {"enum": ["direct", "family", "reference_lab"]}, "adapter": {"$ref": "#/definitions/sourcePath"}, "example": {"$ref": "#/definitions/sourcePath"}, "notes": {"$ref": "#/definitions/text"}}
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["modelId", "operation", "parameters", "convention", "desktopLoad", "webLoad", "gatewayOperation", "sceneViews"],
      "properties": {
        "modelId": {"$ref": "#/definitions/id"}, "operation": {"$ref": "#/definitions/operation"},
        "parameters": {"type": "object", "minProperties": 1, "maxProperties": 32, "propertyNames": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,99}$"}, "additionalProperties": {"anyOf": [{"type": "number", "minimum": -1e100, "maximum": 1e100}, {"$ref": "#/definitions/text"}]}},
        "convention": {"$ref": "#/definitions/text"}, "desktopLoad": {"const": true}, "webLoad": {"type": "boolean"},
        "gatewayOperation": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/operation"}]},
        "sceneViews": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["standard", "bands"]}}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["atlasId", "reference", "sourceExample", "relatedModelIds", "binding", "executionReview", "physicsGap"],
      "properties": {
        "atlasId": {"$ref": "#/definitions/id"}, "reference": {"const": true},
        "sourceExample": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/sourceExample"}]},
        "relatedModelIds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
        "binding": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/binding"}]},
        "executionReview": {"enum": ["preserved-binding", "adapter-candidate", "new-model-required", "reference-only", "accepted-binding"]},
        "physicsGap": {
          "type": "object", "additionalProperties": false, "required": ["status", "groupId", "priority"],
          "properties": {
            "status": {"enum": ["covered-subspace", "parameter-adapter", "new-model"]},
            "groupId": {"anyOf": [{"type": "null"}, {"$ref": "#/definitions/groupId"}]},
            "priority": {"type": "integer", "minimum": 0, "maximum": 4}
          }
        }
      }
    }
  }
}
