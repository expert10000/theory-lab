{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/quantum-landau-result.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "jobId", "runId", "status", "model", "candidates", "globalMinima", "quarticDeterminant", "marginalQuartic", "units", "provenance"],
  "properties": {
    "schema": { "const": "quantum-landau-result/v1" },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$" },
    "status": { "const": "completed" },
    "model": { "type": "object", "additionalProperties": false, "required": ["type", "parameters"],
      "properties": {
        "type": { "const": "two_order_landau" },
        "parameters": { "type": "object", "additionalProperties": false,
          "required": ["a1", "a2", "b1", "b2", "g"],
          "properties": {
            "a1": { "type": "number", "minimum": -2, "maximum": 2 },
            "a2": { "type": "number", "minimum": -2, "maximum": 2 },
            "b1": { "type": "number", "minimum": 0.2, "maximum": 4 },
            "b2": { "type": "number", "minimum": 0.2, "maximum": 4 },
            "g": { "type": "number", "minimum": 0, "maximum": 4 }
          }
        }
      }
    },
    "candidates": { "type": "array", "minItems": 1, "maxItems": 4,
      "items": { "type": "object", "additionalProperties": false,
        "required": ["phase", "x", "y", "freeEnergy", "locallyStable"],
        "properties": {
          "phase": { "enum": ["normal", "sc1", "sc2", "mixed"] },
          "x": { "type": "number", "minimum": 0, "maximum": 20 },
          "y": { "type": "number", "minimum": 0, "maximum": 20 },
          "freeEnergy": { "type": "number", "minimum": -40, "maximum": 80 },
          "locallyStable": { "type": "boolean" }
        }
      }
    },
    "globalMinima": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "enum": ["normal", "sc1", "sc2", "mixed"] } },
    "quarticDeterminant": { "type": "number", "minimum": -16, "maximum": 16 },
    "marginalQuartic": { "type": "boolean" },
    "units": { "type": "object", "additionalProperties": false,
      "required": ["orderAmplitude", "freeEnergy"],
      "properties": { "orderAmplitude": { "const": "dimensionless" }, "freeEnergy": { "const": "dimensionless" } }
    },
    "provenance": { "type": "object", "additionalProperties": false,
      "required": ["pythonVersion", "workerVersion", "computedAt", "durationMs"],
      "properties": {
        "pythonVersion": { "type": "string", "minLength": 1 },
        "workerVersion": { "type": "string", "minLength": 1 },
        "computedAt": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    }
  }
}
