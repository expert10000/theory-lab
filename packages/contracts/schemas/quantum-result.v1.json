                    "amplitude": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "frequency": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "phase": {
                      "type": "number",
                      "minimum": -1000,
                      "maximum": 1000
                    }
                  },
                  "required": ["delta", "amplitude", "frequency", "phase"]
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sourceRepository": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "sourceModule": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "volume": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "chapter": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "exampleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "required": [],
                  "minProperties": 1
                }
              },
              "required": ["type", "parameters"],
              "if": { "type": "object", "properties": { "type": { "const": "strong_drive" } } },
              "then": { "type": "object", "properties": { "parameters": { "type": "object", "properties": { "frequency": { "type": "number", "exclusiveMinimum": 0 } } } } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "landau_zener"
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sweepRate": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "gap": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "bias": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "required": ["sweepRate", "gap", "bias"]
                },
                "source": {
                  "type": "object",
