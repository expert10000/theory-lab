  "$id": "schemas/quantum-result.v1.json",
  "definitions": {
    "sweepAxis": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "parameter": { "enum": ["delta", "amplitude", "frequency", "phase", "sweepRate", "gap", "bias", "turnTime"] },
        "start": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "stop": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
