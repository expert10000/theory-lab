                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                }
              },
              "required": ["delta", "omega"]
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sourceRepository": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "sourceModule": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "volume": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "chapter": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "exampleId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [],
              "minProperties": 1
            }
          },
          "required": ["type", "parameters"]
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
