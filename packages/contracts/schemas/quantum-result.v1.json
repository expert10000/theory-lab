  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "quantum-result/v1"
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "status": {
          "const": "completed"
        },
        "operation": {
          "const": "diagonalize"
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "two_level"
