                    "sourceRepository": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "sourceModule": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "volume": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "chapter": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "exampleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
