          "properties": {
            "x": { "$ref": "#/definitions/sweepAxis" },
            "y": { "anyOf": [{ "$ref": "#/definitions/sweepAxis" }, { "type": "null" }] },
            "metric": { "const": "final_p1" },
            "tStart": { "type": "number", "minimum": -1000, "maximum": 1000 },
            "tStop": { "type": "number", "minimum": -1000, "maximum": 1000 },
            "initialIndex": { "type": "integer", "enum": [0, 1] }
          },
          "required": ["x", "y", "metric", "tStart", "tStop", "initialIndex"]
        },
        "engine": {
          "type": "object", "additionalProperties": false,
          "properties": { "name": { "enum": ["qutip", "native"] }, "version": { "type": "string", "minLength": 1 } },
          "required": ["name", "version"]
        },
        "data": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "schema": { "const": "quantum-sweep-data/v1" },
            "format": { "const": "f64le" },
            "path": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.f64$" },
            "shape": {
              "type": "object", "additionalProperties": false,
              "properties": { "x": { "type": "integer", "minimum": 2, "maximum": 101 }, "y": { "type": "integer", "minimum": 1, "maximum": 101 } },
              "required": ["x", "y"]
            },
            "bytes": { "type": "integer", "minimum": 16, "maximum": 81608 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "required": ["schema", "format", "path", "shape", "bytes", "sha256"]
        },
        "cache": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "reusedPoints": { "type": "integer", "minimum": 0, "maximum": 10201 },
            "computedPoints": { "type": "integer", "minimum": 0, "maximum": 10201 }
          },
          "required": ["key", "reusedPoints", "computedPoints"]
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "pythonVersion": { "type": "string" }, "workerVersion": { "type": "string" },
            "computedAt": { "type": "string", "minLength": 20 },
            "durationMs": { "type": "number", "minimum": 0 }
          },
          "required": ["pythonVersion", "workerVersion", "computedAt", "durationMs"]
        }
      },
      "required": ["schema", "jobId", "runId", "status", "operation", "model", "sweep", "engine", "data", "cache", "provenance"]
    }
  ]
}
