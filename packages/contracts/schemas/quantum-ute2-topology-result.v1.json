{
  "$schema":"http://json-schema.org/draft-07/schema#","$id":"schemas/quantum-ute2-topology-result.v1.json",
  "type":"object","additionalProperties":false,
  "required":["schema","jobId","runId","status","model","basis","orientation","bulkMinimumEnergy","bulkGap","sampledMinimumEnergy","gapClosed","coarseMesh","fineMesh","coarseLinkChern","fineLinkChern","coarseMinimumLink","fineMinimumLink","curvatureIntegralCoarse","curvatureIntegralFine","analyticExpectedChern","chern","invariantStatus","units","provenance"],
  "properties":{
    "schema":{"const":"quantum-ute2-topology-result/v1"},
    "jobId":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[A-Za-z0-9_-]+$"},
    "runId":{"type":"string","minLength":1,"maxLength":100,"pattern":"^[A-Za-z0-9_-]+$"},
    "status":{"const":"completed"},
    "model":{"type":"object","additionalProperties":false,"required":["type","parameters"],
      "properties":{"type":{"const":"square_lattice_class_d"},
        "parameters":{"type":"object","additionalProperties":false,"required":["mu","delta","mesh"],
          "properties":{"mu":{"type":"number","minimum":-5,"maximum":5},
            "delta":{"type":"number","minimum":0,"maximum":2},
            "mesh":{"type":"integer","enum":[12,16,20]}}}}},
    "basis":{"const":"spinless two-component Nambu lattice toy"},
    "orientation":{"const":"occupied band; kx then ky; x-major half-open torus"},
    "bulkMinimumEnergy":{"type":"number","minimum":0,"maximum":10},
    "bulkGap":{"type":"number","minimum":0,"maximum":20},
    "sampledMinimumEnergy":{"type":"number","minimum":0,"maximum":10},
    "gapClosed":{"type":"boolean"},
    "coarseMesh":{"type":"integer","enum":[12,16,20]},
    "fineMesh":{"type":"integer","enum":[24,32,40]},
    "coarseLinkChern":{"type":["integer","null"],"minimum":-2,"maximum":2},
    "fineLinkChern":{"type":["integer","null"],"minimum":-2,"maximum":2},
    "coarseMinimumLink":{"type":["number","null"],"minimum":0,"maximum":1},
    "fineMinimumLink":{"type":["number","null"],"minimum":0,"maximum":1},
    "curvatureIntegralCoarse":{"type":["number","null"],"minimum":-100,"maximum":100},
    "curvatureIntegralFine":{"type":["number","null"],"minimum":-100,"maximum":100},
    "analyticExpectedChern":{"type":["integer","null"],"minimum":-1,"maximum":1},
    "chern":{"type":["integer","null"],"minimum":-1,"maximum":1},
    "invariantStatus":{"enum":["defined","gap_closed","mesh_unresolved"]},
    "units":{"type":"object","additionalProperties":false,"required":["momentum","energy"],
      "properties":{"momentum":{"const":"rad/a"},"energy":{"const":"t=1"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["pythonVersion","workerVersion","computedAt","durationMs"],
      "properties":{"pythonVersion":{"type":"string","minLength":1},"workerVersion":{"type":"string","minLength":1},
        "computedAt":{"type":"string","minLength":1},"durationMs":{"type":"number","minimum":0}}}
  }
}
