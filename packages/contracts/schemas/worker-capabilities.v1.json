{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/worker-capabilities.v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "worker-capabilities/v1"
    },
    "protocol": {
      "const": 1
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "required": ["version"]
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string"
        }
      },
      "required": ["version"]
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "qutip": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "available": {
              "type": "boolean"
            },
            "version": {
              "type": ["string", "null"]
            }
          },
          "required": ["available", "version"]
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "available": {
              "type": "boolean"
            },
            "version": {
              "type": ["string", "null"]
            }
          },
          "required": ["available", "version"]
        },
        "dynamiqs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "available": { "type": "boolean" },
            "version": { "type": ["string", "null"] },
            "device": { "type": ["string", "null"] }
          },
          "required": ["available", "version", "device"]
        },
        "quspin": {
          "type": "object", "additionalProperties": false,
          "properties": { "available": { "type": "boolean" }, "version": { "type": ["string", "null"] } },
          "required": ["available", "version"]
        },
        "scqubits": {
          "type": "object", "additionalProperties": false,
          "properties": { "available": { "type": "boolean" }, "version": { "type": ["string", "null"] } },
          "required": ["available", "version"]
        }
      },
      "required": ["qutip", "native"]
    },
    "operations": {
      "type": "array",
      "items": {
        "enum": ["diagonalize", "evolve", "cavity", "lindblad", "sweep", "many_body", "circuit", "topology", "orbital", "oscillator", "oscillator_evolve", "oscillator_drive"]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "protocol",
    "worker",
    "python",
    "engines",
    "operations"
  ]
}
