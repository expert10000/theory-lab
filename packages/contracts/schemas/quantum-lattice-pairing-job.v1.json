{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "schemas/quantum-lattice-pairing-job.v1.json",
  "type": "object", "additionalProperties": false, "required": ["schema", "jobId", "model"],
  "properties": {
    "schema": {"const": "quantum-lattice-pairing-job/v1"},
    "jobId": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$"},
    "model": {"type": "object", "additionalProperties": false, "required": ["type", "parameters"],
      "properties": {
        "type": {"const": "square_lattice_px_py"},
        "parameters": {"type": "object", "additionalProperties": false,
          "required": ["mu", "amplitudeX", "amplitudeY", "relativePhaseRad", "gridSize"],
          "properties": {
            "mu": {"type": "number", "minimum": -5, "maximum": 5},
            "amplitudeX": {"type": "number", "minimum": 0, "maximum": 2},
            "amplitudeY": {"type": "number", "minimum": 0, "maximum": 2},
            "relativePhaseRad": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793},
            "gridSize": {"type": "integer", "enum": [12, 16, 20, 24]}
          }
        }
      }
    }
  }
}
