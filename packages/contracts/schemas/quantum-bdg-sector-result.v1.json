{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "schemas/quantum-bdg-sector-result.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "jobId", "runId", "status", "model", "basis", "samples", "minimumPositiveEnergy", "gapClosed", "units", "provenance"],
  "properties": {
    "schema": { "const": "quantum-bdg-sector-result/v1" },
    "jobId": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$" },
    "runId": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$" },
    "status": { "const": "completed" },
    "model": { "type": "object", "additionalProperties": false, "required": ["type", "parameters"],
      "properties": { "type": { "const": "reduced_bdg_2x2" },
        "parameters": { "type": "object", "additionalProperties": false,
          "required": ["extent", "delta", "phaseRad", "points"],
          "properties": {
            "extent": { "type": "number", "minimum": 0.5, "maximum": 4 },
            "delta": { "type": "number", "minimum": 0, "maximum": 2 },
            "phaseRad": { "type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793 },
            "points": { "type": "integer", "minimum": 51, "maximum": 201 }
          }
        }
      }
    },
    "basis": { "const": "reduced two-component Nambu sector" },
    "samples": { "type": "array", "minItems": 51, "maxItems": 201,
      "items": { "type": "object", "additionalProperties": false,
        "required": ["xi", "eMinus", "ePlus", "electronWeight", "holeWeight", "pairingPhaseRad", "node"],
        "properties": {
          "xi": { "type": "number", "minimum": -4, "maximum": 4 },
          "eMinus": { "type": "number", "minimum": -5, "maximum": 0 },
          "ePlus": { "type": "number", "minimum": 0, "maximum": 5 },
          "electronWeight": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "holeWeight": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "pairingPhaseRad": { "type": ["number", "null"], "minimum": -3.141592653589793, "maximum": 3.141592653589793 },
          "node": { "type": "boolean" }
        }
      }
    },
    "minimumPositiveEnergy": { "type": "number", "minimum": 0, "maximum": 5 },
    "gapClosed": { "type": "boolean" },
    "units": { "type": "object", "additionalProperties": false,
      "required": ["xi", "energy", "phase"],
      "properties": { "xi": { "const": "dimensionless" }, "energy": { "const": "dimensionless" }, "phase": { "const": "rad" } }
    },
    "provenance": { "type": "object", "additionalProperties": false,
      "required": ["pythonVersion", "workerVersion", "computedAt", "durationMs"],
      "properties": {
        "pythonVersion": { "type": "string", "minLength": 1 },
        "workerVersion": { "type": "string", "minLength": 1 },
        "computedAt": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "number", "minimum": 0 }
      }
    }
  }
}
