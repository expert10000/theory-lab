{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/quantum-bose-hubbard-job.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "jobId",
    "engine",
    "model"
  ],
  "properties": {
    "schema": {
      "const": "quantum-bose-hubbard-job/v1"
    },
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "engine": {
      "const": "native"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "parameters"
      ],
      "properties": {
        "type": {
          "const": "bose_hubbard_dimer"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "particles",
            "interactionRatio",
            "hopping",
            "boundary"
          ],
          "properties": {
            "particles": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8
            },
            "interactionRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 20
            },
            "hopping": {
              "const": 1
            },
            "boundary": {
              "const": "open"
            }
          }
        }
      }
    }
  }
}
