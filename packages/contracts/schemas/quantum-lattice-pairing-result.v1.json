{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "schemas/quantum-lattice-pairing-result.v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "jobId", "runId", "status", "model", "basis", "grid", "samples", "sampledMinimumEnergy", "sampledGapClosed", "units", "provenance"],
  "properties": {
    "schema": {"const": "quantum-lattice-pairing-result/v1"},
    "jobId": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$"},
    "runId": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$"},
    "status": {"const": "completed"},
    "model": {"type": "object", "additionalProperties": false, "required": ["type", "parameters"],
      "properties": {"type": {"const": "square_lattice_px_py"},
        "parameters": {"type": "object", "additionalProperties": false,
          "required": ["mu", "amplitudeX", "amplitudeY", "relativePhaseRad", "gridSize"],
          "properties": {
            "mu": {"type": "number", "minimum": -5, "maximum": 5},
            "amplitudeX": {"type": "number", "minimum": 0, "maximum": 2},
            "amplitudeY": {"type": "number", "minimum": 0, "maximum": 2},
            "relativePhaseRad": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793},
            "gridSize": {"type": "integer", "enum": [12, 16, 20, 24]}
          }
        }
      }
    },
    "basis": {"const": "spinless two-component Nambu lattice toy"},
    "grid": {"type": "object", "additionalProperties": false, "required": ["order", "domain", "spacing"],
      "properties": {"order": {"const": "kx-major/ky-minor"}, "domain": {"const": "[-pi,pi)"},
        "spacing": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}},
    "samples": {"type": "array", "minItems": 144, "maxItems": 576,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["kx", "ky", "xi", "deltaRe", "deltaIm", "gapMagnitude", "phaseRad", "eMinus", "ePlus", "electronWeight", "holeWeight", "node"],
        "properties": {
          "kx": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793},
          "ky": {"type": "number", "minimum": -3.141592653589793, "maximum": 3.141592653589793},
          "xi": {"type": "number", "minimum": -9, "maximum": 9},
          "deltaRe": {"type": "number", "minimum": -4, "maximum": 4},
          "deltaIm": {"type": "number", "minimum": -2, "maximum": 2},
          "gapMagnitude": {"type": "number", "minimum": 0, "maximum": 4},
          "phaseRad": {"type": ["number", "null"], "minimum": -3.141592653589793, "maximum": 3.141592653589793},
          "eMinus": {"type": "number", "minimum": -10, "maximum": 0},
          "ePlus": {"type": "number", "minimum": 0, "maximum": 10},
          "electronWeight": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "holeWeight": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "node": {"type": "boolean"}
        }
      }
    },
    "sampledMinimumEnergy": {"type": "number", "minimum": 0, "maximum": 10},
    "sampledGapClosed": {"type": "boolean"},
    "units": {"type": "object", "additionalProperties": false, "required": ["momentum", "energy", "phase"],
      "properties": {"momentum": {"const": "rad/a"}, "energy": {"const": "t=1"}, "phase": {"const": "rad"}}},
    "provenance": {"type": "object", "additionalProperties": false,
      "required": ["pythonVersion", "workerVersion", "computedAt", "durationMs"],
      "properties": {"pythonVersion": {"type": "string", "minLength": 1}, "workerVersion": {"type": "string", "minLength": 1},
        "computedAt": {"type": "string", "minLength": 1}, "durationMs": {"type": "number", "minimum": 0}}}
  }
}
