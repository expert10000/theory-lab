{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/quantum-job.v1.json",
  "definitions": {
    "sweepAxis": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "parameter": { "enum": ["delta", "amplitude", "frequency", "phase", "sweepRate", "gap", "bias", "turnTime"] },
        "start": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "stop": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
        "points": { "type": "integer", "minimum": 2, "maximum": 101 }
      },
      "required": ["parameter", "start", "stop", "points"]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "quantum-job/v1"
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "operation": {
          "const": "diagonalize"
        },
        "engine": {
          "enum": ["qutip", "native"]
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "two_level"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "delta": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "omega": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                }
              },
              "required": ["delta", "omega"]
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sourceRepository": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "sourceModule": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "volume": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "chapter": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "exampleId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [],
              "minProperties": 1
            }
          },
          "required": ["type", "parameters"]
        }
      },
      "required": ["schema", "jobId", "operation", "engine", "model"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "quantum-job/v1"
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "operation": {
          "const": "evolve"
        },
        "engine": {
          "enum": ["qutip", "native", "dynamiqs"]
        },
        "model": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": ["driven_two_level", "strong_drive"]
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "delta": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "amplitude": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "frequency": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "phase": {
                      "type": "number",
                      "minimum": -1000,
                      "maximum": 1000
                    }
                  },
                  "required": ["delta", "amplitude", "frequency", "phase"]
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sourceRepository": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "sourceModule": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "volume": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "chapter": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "exampleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "required": [],
                  "minProperties": 1
                }
              },
              "required": ["type", "parameters"],
              "if": { "type": "object", "properties": { "type": { "const": "strong_drive" } } },
              "then": { "type": "object", "properties": { "parameters": { "type": "object", "properties": { "frequency": { "type": "number", "exclusiveMinimum": 0 } } } } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "landau_zener"
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sweepRate": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "gap": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "bias": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "required": ["sweepRate", "gap", "bias"]
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sourceRepository": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "sourceModule": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "volume": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "chapter": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "exampleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "required": [],
                  "minProperties": 1
                }
              },
              "required": ["type", "parameters"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": { "const": "stuckelberg" },
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sweepRate": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "gap": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "bias": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "turnTime": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 1000
                    }
                  },
                  "required": ["sweepRate", "gap", "bias", "turnTime"]
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sourceRepository": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "sourceModule": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "volume": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "chapter": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "exampleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "required": [],
                  "minProperties": 1
                }
              },
              "required": ["type", "parameters"]
            }
          ]
        },
        "initialState": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "basis"
            },
            "index": {
              "type": "integer",
              "enum": [0, 1]
            }
          },
          "required": ["type", "index"]
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "schrodinger"
            },
            "tStart": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000
            },
            "tStop": {
              "type": "number",
              "exclusiveMinimum": -1000,
              "maximum": 1000
            },
            "samples": {
              "type": "integer",
              "minimum": 2,
              "maximum": 50000
            }
          },
          "required": ["type", "tStart", "tStop", "samples"]
        },
        "observables": {
          "type": "array",
          "items": {
            "enum": ["p0", "p1", "sigma_x", "sigma_y", "sigma_z"]
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "schema",
        "jobId",
        "operation",
        "engine",
        "model",
        "initialState",
        "solver",
        "observables"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "quantum-job/v1" },
        "jobId": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$" },
        "operation": { "const": "cavity" },
        "engine": { "enum": ["qutip", "native"] },
        "model": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "enum": ["jaynes_cummings", "quantum_rabi"] },
            "parameters": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "qubitFrequency": { "type": "number", "minimum": 0, "maximum": 1000 },
                "cavityFrequency": { "type": "number", "minimum": 0, "maximum": 1000 },
                "coupling": { "type": "number", "minimum": 0, "maximum": 100 },
                "cutoff": { "type": "integer", "minimum": 3, "maximum": 20 }
              },
              "required": ["qubitFrequency", "cavityFrequency", "coupling", "cutoff"]
            },
            "source": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "sourceRepository": { "type": "string", "minLength": 1, "maxLength": 300 },
                "sourceModule": { "type": "string", "minLength": 1, "maxLength": 300 },
                "volume": { "type": "string", "minLength": 1, "maxLength": 100 },
                "chapter": { "type": "string", "minLength": 1, "maxLength": 100 },
                "exampleId": { "type": "string", "minLength": 1, "maxLength": 100 }
              },
              "minProperties": 1
            }
          },
          "required": ["type", "parameters"]
        },
        "initialState": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "qubit": { "enum": ["ground", "excited"] },
            "photons": { "type": "integer", "minimum": 0, "maximum": 19 }
          },
          "required": ["qubit", "photons"]
        },
        "solver": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "schrodinger" },
            "tStart": { "type": "number", "minimum": -1000, "maximum": 1000 },
            "tStop": { "type": "number", "minimum": -1000, "maximum": 1000 },
            "samples": { "type": "integer", "minimum": 2, "maximum": 5000 }
          },
          "required": ["type", "tStart", "tStop", "samples"]
        }
      },
      "required": ["schema", "jobId", "operation", "engine", "model", "initialState", "solver"]
    },
    {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": { "const": "quantum-job/v1" },
        "jobId": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$" },
        "operation": { "const": "sweep" },
        "engine": { "enum": ["qutip", "native"] },
        "model": { "$ref": "#/oneOf/1/properties/model" },
        "sweep": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "x": { "$ref": "#/definitions/sweepAxis" },
            "y": { "anyOf": [{ "$ref": "#/definitions/sweepAxis" }, { "type": "null" }] },
            "metric": { "const": "final_p1" },
            "tStart": { "type": "number", "minimum": -1000, "maximum": 1000 },
            "tStop": { "type": "number", "minimum": -1000, "maximum": 1000 },
            "initialIndex": { "type": "integer", "enum": [0, 1] }
          },
          "required": ["x", "y", "metric", "tStart", "tStop", "initialIndex"]
        }
      },
      "required": ["schema", "jobId", "operation", "engine", "model", "sweep"]
    },
    {
      "type": "object", "additionalProperties": false,
      "properties": {
        "schema": { "const": "quantum-job/v1" },
        "jobId": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9_-]+$" },
        "operation": { "const": "lindblad" },
        "engine": { "enum": ["qutip", "native"] },
        "model": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "open_jaynes_cummings" },
            "parameters": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "qubitDetuning": { "type": "number", "minimum": -1000, "maximum": 1000 },
                "cavityDetuning": { "type": "number", "minimum": -1000, "maximum": 1000 },
                "coupling": { "type": "number", "minimum": 0, "maximum": 100 },
                "driveAmplitude": { "type": "number", "minimum": -100, "maximum": 100 },
                "relaxation": { "type": "number", "minimum": 0, "maximum": 100 },
                "dephasing": { "type": "number", "minimum": 0, "maximum": 100 },
                "cavityLoss": { "type": "number", "minimum": 0, "maximum": 100 },
                "cutoff": { "type": "integer", "minimum": 3, "maximum": 12 }
              },
              "required": ["qubitDetuning", "cavityDetuning", "coupling", "driveAmplitude", "relaxation", "dephasing", "cavityLoss", "cutoff"]
            },
            "source": {
              "type": "object", "additionalProperties": false, "minProperties": 1,
              "properties": {
                "sourceRepository": { "type": "string", "minLength": 1, "maxLength": 300 },
                "sourceModule": { "type": "string", "minLength": 1, "maxLength": 300 },
                "volume": { "type": "string", "minLength": 1, "maxLength": 100 },
                "chapter": { "type": "string", "minLength": 1, "maxLength": 100 },
                "exampleId": { "type": "string", "minLength": 1, "maxLength": 100 }
              }
            }
          },
          "required": ["type", "parameters"]
        },
        "initialState": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "qubit": { "enum": ["ground", "excited", "plus_x"] },
            "photons": { "type": "integer", "minimum": 0, "maximum": 11 }
          },
          "required": ["qubit", "photons"]
        },
        "solver": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "type": { "const": "master" },
            "tStart": { "type": "number", "minimum": -1000, "maximum": 1000 },
            "tStop": { "type": "number", "minimum": -1000, "maximum": 1000 },
            "samples": { "type": "integer", "minimum": 2, "maximum": 5000 }
          },
          "required": ["type", "tStart", "tStop", "samples"]
        }
      },
      "required": ["schema", "jobId", "operation", "engine", "model", "initialState", "solver"]
    }
  ]
}
