{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/quantum-job.v1.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "quantum-job/v1"
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "operation": {
          "const": "diagonalize"
        },
        "engine": {
          "enum": ["qutip", "native"]
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "two_level"
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "delta": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "omega": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                }
              },
              "required": ["delta", "omega"]
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sourceRepository": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "sourceModule": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "volume": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "chapter": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "exampleId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [],
              "minProperties": 1
            }
          },
          "required": ["type", "parameters"]
        }
      },
      "required": ["schema", "jobId", "operation", "engine", "model"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "quantum-job/v1"
        },
        "jobId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "operation": {
          "const": "evolve"
        },
        "engine": {
          "enum": ["qutip", "native"]
        },
        "model": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "driven_two_level"
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "delta": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "amplitude": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "frequency": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "phase": {
                      "type": "number",
                      "minimum": -1000,
                      "maximum": 1000
                    }
                  },
                  "required": ["delta", "amplitude", "frequency", "phase"]
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sourceRepository": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "sourceModule": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "volume": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "chapter": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "exampleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "required": [],
                  "minProperties": 1
                }
              },
              "required": ["type", "parameters"]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "const": "landau_zener"
                },
                "parameters": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sweepRate": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "gap": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    },
                    "bias": {
                      "type": "number",
                      "minimum": -1000000,
                      "maximum": 1000000
                    }
                  },
                  "required": ["sweepRate", "gap", "bias"]
                },
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "sourceRepository": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "sourceModule": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "volume": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "chapter": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "exampleId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "required": [],
                  "minProperties": 1
                }
              },
              "required": ["type", "parameters"]
            }
          ]
        },
        "initialState": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "basis"
            },
            "index": {
              "type": "integer",
              "enum": [0, 1]
            }
          },
          "required": ["type", "index"]
        },
        "solver": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "schrodinger"
            },
            "tStart": {
              "type": "number",
              "minimum": -1000,
              "maximum": 1000
            },
            "tStop": {
              "type": "number",
              "exclusiveMinimum": -1000,
              "maximum": 1000
            },
            "samples": {
              "type": "integer",
              "minimum": 2,
              "maximum": 50000
            }
          },
          "required": ["type", "tStart", "tStop", "samples"]
        },
        "observables": {
          "type": "array",
          "items": {
            "enum": ["p0", "p1", "sigma_x", "sigma_y", "sigma_z"]
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        }
      },
      "required": [
        "schema",
        "jobId",
        "operation",
        "engine",
        "model",
        "initialState",
        "solver",
        "observables"
      ]
    }
  ]
}
