{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/worker-resources.v1.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "worker-resources/v1" },
    "platform": {
      "type": "object", "additionalProperties": false,
      "properties": { "system": { "type": "string", "maxLength": 64 }, "machine": { "type": "string", "maxLength": 64 } },
      "required": ["system", "machine"]
    },
    "cpu": {
      "type": "object", "additionalProperties": false,
      "properties": { "logicalCores": { "type": "integer", "minimum": 1 } }, "required": ["logicalCores"]
    },
    "memory": {
      "type": "object", "additionalProperties": false,
      "properties": { "totalBytes": { "type": ["integer", "null"], "minimum": 0 } }, "required": ["totalBytes"]
    },
    "job": {
      "type": "object", "additionalProperties": false,
      "properties": { "activeId": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{1,100}$" } },
      "required": ["activeId"]
    }
  },
  "required": ["schema", "platform", "cpu", "memory", "job"]
}
