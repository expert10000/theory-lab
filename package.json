{
  "name": "theory-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "package:win:dir": "npm run build && node scripts/build-frozen-worker.mjs && electron-builder --win --dir --config electron-builder.config.cjs",
    "package:win:installer": "npm run build && node scripts/build-frozen-worker.mjs && electron-builder --win nsis --config electron-builder.config.cjs",
    "package:win:installer:qi40": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-qi40-installer.ps1",
    "start": "node scripts/launch.mjs",
    "dev": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:worker": "node scripts/python.mjs -m unittest discover -s workers/quantum-python/tests -v",
    "test:desktop": "npm run build && node scripts/smoke.mjs",
    "test:bose-hubbard-desktop": "npm run build && node scripts/smoke-bose-hubbard.mjs",
    "test:landau-desktop": "npm run build && node scripts/smoke-landau.mjs",
    "test:bdg-sector-desktop": "npm run build && node scripts/smoke-bdg-sector.mjs",
    "test:lattice-pairing-desktop": "npm run build && node scripts/smoke-lattice-pairing.mjs",
    "test:ute2-topology-desktop": "npm run build && node scripts/smoke-ute2-topology.mjs",
    "accept:rb87-installed": "node scripts/accept-rb87-installed.mjs",
    "test:web": "npm run build && tsx scripts/smoke-web.ts",
    "test:scenes": "tsx scripts/smoke-scenes.ts",
    "test:qi40-source": "tsx scripts/verify-qi40-source.ts",
    "verify:qi40-retained": "node scripts/verify-qi40-retained.mjs",
    "verify:ute2-source": "node scripts/verify-ute2-source.mjs",
    "accept:qi40-math3d": "node scripts/accept-qi40-math3d.mjs",
    "extract:qi40-candidate": "node scripts/extract-qi40-candidate.mjs",
    "stage:qi40-pair": "node scripts/stage-qi40-pair.mjs",
    "accept:qi40-matched": "node scripts/accept-qi40-matched.mjs",
    "accept:qi40-release-pair": "node scripts/accept-qi40-release-pair.mjs",
    "verify:qi40-release-pair": "node scripts/verify-qi40-release-pair.mjs",
    "accept:qi40-installed-lab": "node scripts/accept-qi40-installed-lab.mjs",
    "verify:qi40-installed-lab": "node scripts/verify-qi40-installed-lab.mjs",
    "verify:qi40-matched": "node scripts/verify-qi40-matched.mjs",
    "accept:qi40-direct-launch": "node scripts/accept-qi40-direct-launch.mjs",
    "verify:qi40-direct-launch": "node scripts/verify-qi40-direct-launch.mjs",
    "accept:packaged-qwz": "node scripts/accept-packaged-qwz.mjs",
    "test:math3d-handoff": "npm run build && node scripts/smoke-math3d-handoff.mjs",
    "test:math3d-installed-target": "npm run build && node scripts/smoke-math3d-installed-target.mjs",
    "test:source-run-locate": "npm run build && node scripts/smoke-source-run-locate.mjs",
    "test:ssh-ui": "npm run build && node scripts/smoke-ssh-ui.mjs",
    "accept:remote": "tsx scripts/accept-remote.ts",
    "accept:transport": "tsx scripts/accept-remote.ts",
    "check:transport": "tsx scripts/check-transport.ts",
    "benchmark:acceleration": "node scripts/python.mjs -m quantum_worker.acceleration",
    "start:gateway": "npm run build && node dist/gateway.cjs",
    "setup:python": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-python.ps1",
    "desktop:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-shortcut.ps1"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "katex": "0.19.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electron/asar": "3.2.18",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
